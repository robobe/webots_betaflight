# Strict IMU/barometer Webots Iris configuration for Betaflight 2026.6.2.
mixer QUADX
map AETR1234
feature -GPS
feature -3D
feature RX_UDP
set yaw_motors_reversed = ON
# Match the reference plant's yaw tuning for the 50 ms motor response.
set p_yaw = 10
set i_yaw = 0
set f_yaw = 0
# Conservative rate control for the Iris plant; RC is generated by an outer loop.
set p_roll = 15
set i_roll = 0
set d_roll = 0
set f_roll = 0
set p_pitch = 15
set i_pitch = 0
set d_pitch = 0
set f_pitch = 0
aux 0 0 0 1700 2100
aux 1 1 1 1700 2100
set failsafe_procedure = DROP
save
